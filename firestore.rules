rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿El usuario que hace la petición es gerente? (lo dice su propio documento de perfil)
    function isManager() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerente';
    }

    // Cada usuario lee y escribe sus propios datos (perfil + días).
    // El gerente, además:
    //  - puede LEER los datos de cualquier otro usuario (para ver a su equipo).
    //  - puede ESCRIBIR el documento de PERFIL (users/{userId}) de otro usuario, para poder
    //    crear vendedores y asignarles su horario desde la app — pero NO puede escribir
    //    dentro de sus subcolecciones (días), esos los controla cada quien.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isManager();
      allow write: if isManager();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if isManager();
      }
    }

    // Roster del equipo: cualquier usuario autenticado puede ver quién forma parte del
    // equipo. Cada quien puede escribir su propio registro, y el gerente puede escribir el
    // de cualquiera (para registrar vendedores que él mismo crea).
    match /teams/{teamId}/members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == memberId || isManager());
    }
  }
}
