rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿El usuario que hace la petición es gerente? (lo dice su propio documento de perfil)
    function isManager() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerente';
    }

    // Cada usuario lee y escribe sus propios datos (perfil + días). El gerente, además,
    // puede LEER (no escribir) los datos de cualquier otro usuario, para ver a su equipo.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isManager();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if isManager();
      }
    }

    // Roster del equipo: cualquier usuario autenticado puede ver quién forma parte del
    // equipo (para que el gerente arme la lista); cada quien solo puede escribir su propio
    // registro (se crea/actualiza solo al iniciar sesión).
    match /teams/{teamId}/members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == memberId;
    }
  }
}
